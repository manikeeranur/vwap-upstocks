# Copy to .env and supply your broker token. Never commit credentials.
UPSTOX_ACCESS_TOKEN=

# Paths are relative to the project root, or may be absolute.
UPSTOCKS_DATABASE_PATH=data/upstocks.sqlite3
UPSTOCKS_LOG_DIR=logs
UPSTOCKS_CACHE_DIR=.cache
UPSTOCKS_LEGACY_DIR=.
UPSTOCKS_HOST=127.0.0.1
UPSTOCKS_ALLOWED_HOSTS=127.0.0.1,localhost,::1
UPSTOCKS_PORT=3400
UPSTOCKS_SCANNER_ENABLED=true
UPSTOCKS_MAX_BACKTESTS=2
UPSTOCKS_LOG_LEVEL=INFO
UPSTOCKS_LOG_MAX_BYTES=10485760
UPSTOCKS_LOG_BACKUPS=5
